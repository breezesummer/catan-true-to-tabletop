# Unity generated data
# Assets 下的 .meta、场景、ProjectSettings 和运行所需 Plugins DLL 保持版本管理。
# 构建产生的无功能序列化差异应还原，不使用忽略规则隐藏这些文件。
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
.utmp/
[Mm]emoryCaptures/
[Rr]ecordings/
[Bb]uild/
[Bb]uilds/

# 本项目的缓存也可能是外部目录软链接；不加结尾斜杠以同时匹配两种形式。
/Unity/Catan/[Ll]ibrary
/Unity/Catan/[Tt]emp
/Unity/Catan/[Ll]ogs
/Unity/Catan/[Uu]ser[Ss]ettings

# .NET and local editor state
**/bin/
**/obj/
TestResults/
.vs/
*.user
*.suo

# Local caches and credentials
/codex.pem
__pycache__/
*.pyc
.venv/
node_modules/
.local/
.env
.env.*
!.env.example

# Blender 恢复备份；制作源文件按下方本地素材规则管理
*.blend1
*.blend2

# 可由已保存的脚本、配方和源贴图重建的中间文件（本地保留）
art/source/entity-conversion-v*/**/*.blend
art/source/photo-samples-v*/*.blend
art/exports/entity-conversion-v*/**/*.fbx
art/exports/entity-conversion-v*/**/textures/
art/exports/photo-samples-v*/*.fbx
art/exports/photo-samples-v*/textures/
art/previews/entity-conversion-v*/
art/previews/photo-samples-v*/

# 操作系统与编辑器临时文件；验证摘要继续入库，截图按下方规则留在本地
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak

# Office 编辑锁文件与 Unity 自动生成的 IDE 工程
~$*.docx
~$*.xlsx
~$*.pptx
/Unity/Catan/*.csproj
/Unity/Catan/*.sln
/Unity/Catan/*.slnx

# 本地可玩版本与构建验证产物
/game version/

# 根目录临时生图提示词；正式提示词保存在对应资产目录
/b302_original_prompt.txt

# 美术制作目录保留本地；已提交的脚本、配方和清单继续维护
/art/concepts/
/art/exports/
/art/source/
/art/previews/
/docs/卡坦岛之三国争霸设计表.xlsx
# 配方中的参考图、原始照片与音频资料保留本地
/art/**/*.png
/art/**/*.jpg
/art/**/*.jpeg
/art/**/*.webp
/art/**/*.gif
/art/**/*.wav
/art/**/*.mp3
/art/**/*.ogg
/art/**/*.blend
/art/**/*.fbx
/art/**/*.glb
/art/**/*.gltf
/assets/references/**/*.png
/assets/references/**/*.jpg
/assets/references/**/*.jpeg
/assets/references/**/*.wav
/assets/references/**/*.mp3
/assets/references/**/*.ogg
/assets/references/**/*.zip

# 文档截图、美术概念原稿和可重新产生的原始诊断输出保留本地
/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.jpeg
/docs/**/*.docx
/docs/verification/**/*.log
/docs/verification/**/*.trx
/docs/verification/**/*.gz
