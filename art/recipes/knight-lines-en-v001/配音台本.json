    { "level": 2, "name": "George", "voiceId": "GLSWsaquVBsIPLPPRi2s", "persona": "身经战阵的粗粝老兵；日常应答松弛、带点傲气，威胁直接而强硬，战场命令短促有力。" },
    { "level": 3, "name": "Lord Griff", "voiceId": "A48Y4xFQ2YpCgXhLXguK", "persona": "有分量的重甲精锐；平时寡言笃定，驱盗时冷硬压迫，进攻时集中发力，战吼坚决。" }
