  "lines": [
    { "id": "KnightRecruit_L1_A", "level": 1, "action": "招募", "variant": "A", "text": "Reporting for duty!", "translation": "前来报到！", "promptText": "[eager][conversational] Reporting for duty!", "direction": "刚到熟悉的队长身边站住，爽快应一声，带一点新兵的冲劲，重音落在 duty，句子短。" },
    { "id": "KnightRecruit_L1_B", "level": 1, "action": "招募", "variant": "B", "text": "Aye. Where do you need me?", "translation": "嗯，需要我去哪儿？", "promptText": "[casual][curious] Aye. Where do you need me?", "direction": "先随口应下，再看向玩家问去处；语气亲近自然，问句有真实的抬头接话感。" },
    { "id": "KnightPromote_L2_A", "level": 2, "action": "晋升", "variant": "A", "text": "Now that's proper armour.", "translation": "这才像样的盔甲。", "promptText": "[dryly][pleased] Now that's proper armour.", "direction": "老兵低头掂量新甲，带满意的笑意，重读 proper；像私下评价自己的装备。" },
    { "id": "KnightPromote_L2_B", "level": 2, "action": "晋升", "variant": "B", "text": "Ha! Let's see them try me now.", "translation": "哈！看谁还敢来招惹我。", "promptText": "[amused] Ha! [taunting] Let's see them try me now.", "direction": "开头短笑，接着带挑衅和得意，说 try me 时咬字有劲，末尾笃定。" },
    { "id": "KnightPromote_L3_A", "level": 3, "action": "晋升", "variant": "A", "text": "I've earned this steel.", "translation": "这身装备，我当之无愧。", "promptText": "[quietly][proud] I've earned this steel.", "direction": "低声承认自己用战功挣来了这身装备，声音有重量，earned 稍重，保持老练的自豪。" },
    { "id": "KnightPromote_L3_B", "level": 3, "action": "晋升", "variant": "B", "text": "Give me the toughest fight.", "translation": "最硬的仗，交给我。", "promptText": "[confident][firm] Give me the toughest fight.", "direction": "迎着玩家平静接下重任，toughest fight 落稳，语气有把握，像一句简单承诺。" },
    { "id": "KnightActivate_L1_A", "level": 1, "action": "激活", "variant": "A", "text": "Payday!", "translation": "发饷啦！", "promptText": "[excited][happy] Payday!", "direction": "刚领到军饷，忍不住高兴地脱口而出；短、亮、有笑意。" },
    { "id": "KnightActivate_L1_B", "level": 1, "action": "激活", "variant": "B", "text": "Fed and ready!", "translation": "吃饱了，有劲了！", "promptText": "[cheerful][energetic] Fed and ready!", "direction": "吃饱后精神一振，像随手拍了拍肚子；fed 有满足感，ready 精神提起来。" },
    { "id": "KnightActivate_L2_A", "level": 2, "action": "激活", "variant": "A", "text": "Good. Back in fighting shape.", "translation": "好，又能痛快打一场了。", "promptText": "[satisfied][confident] Good. Back in fighting shape.", "direction": "活动过肩膀、恢复状态后随口确认；Good 短一点，后半句带老兵重回状态的底气。" },
    { "id": "KnightActivate_L2_B", "level": 2, "action": "激活", "variant": "B", "text": "Armed and ready.", "translation": "兵器在手，准备好了。", "promptText": "[matter-of-fact][confident] Armed and ready.", "direction": "检查好武器后给身旁玩家一句可靠应答，利落、从容，两处重音自然。" },
    { "id": "KnightActivate_L3_A", "level": 3, "action": "激活", "variant": "A", "text": "Just give me the word.", "translation": "就等你一句话。", "promptText": "[calm][assured] Just give me the word.", "direction": "低而近地回应指挥者，声气稳，word 落实，表现随时等候安排的可靠感。" },
    { "id": "KnightActivate_L3_B", "level": 3, "action": "激活", "variant": "B", "text": "Rested. Fed. Ready.", "translation": "歇够了，吃饱了，准备好了。", "promptText": "[dryly][assured] Rested. Fed. Ready.", "direction": "带一点重骑士的冷幽默，三个短确认逐步落下，停顿简短自然，最后 Ready 更笃定。" },
    { "id": "KnightChasePirate_L1_A", "level": 1, "action": "驱赶海盗", "variant": "A", "text": "Run, you sea rats!", "translation": "海上的臭老鼠，快滚！", "promptText": "[angry][shouts] Run, you sea rats!", "direction": "朝近岸贼船怒喝，带真火气，run 先冲出来，sea rats 带咬牙的鄙视，收尾果断。" },
    { "id": "KnightChasePirate_L1_B", "level": 1, "action": "驱赶海盗", "variant": "B", "text": "I'll sink you!", "translation": "我把你们全沉了！", "promptText": "[furious][threatening] I'll sink you!", "direction": "年轻骑士被海盗激怒后的直接威胁；sink 要狠、要清楚，气息短促，语势向前。" },
    { "id": "KnightChasePirate_L2_A", "level": 2, "action": "驱赶海盗", "variant": "A", "text": "To the bottom with you!", "translation": "送你们去海底！", "promptText": "[angry][commanding] To the bottom with you!", "direction": "老兵朝贼船强硬喝斥，bottom 加重，带粗粝的杀气，整句一口推出去。" },
    { "id": "KnightChasePirate_L2_B", "level": 2, "action": "驱赶海盗", "variant": "B", "text": "Your ship's your coffin!", "translation": "这条船，就是你们的棺材！", "promptText": "[menacing][taunting] Your ship's your coffin!", "direction": "像已经看穿海盗的下场，短促冷笑般挑衅，ship 与 coffin 对照清楚，最后一个词压狠。" },
    { "id": "KnightChasePirate_L3_A", "level": 3, "action": "驱赶海盗", "variant": "A", "text": "Sail away, or die here.", "translation": "开船滚，或者死在这里。", "promptText": "[coldly][threatening] Sail away, or die here.", "direction": "重骑士给出冷硬的最后通牒，前半句压住，or 处稍停，die here 更低更重，威胁明确。" },
    { "id": "KnightChasePirate_L3_B", "level": 3, "action": "驱赶海盗", "variant": "B", "text": "I'll bury you at sea.", "translation": "我让你们葬身海底。", "promptText": "[coldly][menacing] I'll bury you at sea.", "direction": "像平静说出即将兑现的后果，bury 有实在的狠劲，sea 尾音落下，保持可听清的正常低声。" },
    { "id": "KnightChaseRobber_L1_A", "level": 1, "action": "驱赶强盗", "variant": "A", "text": "Run, you filthy thief!", "translation": "快滚，你这肮脏的贼！", "promptText": "[angry][disgusted] Run, you filthy thief!", "direction": "冲到挡路强盗面前怒斥，filthy thief 带明显厌恶，火气直接，收得短。" },
    { "id": "KnightChaseRobber_L1_B", "level": 1, "action": "驱赶强盗", "variant": "B", "text": "Back off, or bleed!", "translation": "滚开，否则让你见血！", "promptText": "[angry][threatening] Back off, or bleed!", "direction": "近距离的凶狠警告；Back off 短而冲，停半拍后把 bleed 砸下去。" },
    { "id": "KnightChaseRobber_L2_A", "level": 2, "action": "驱赶强盗", "variant": "A", "text": "Move, or meet my blade!", "translation": "滚开，不然吃我一剑！", "promptText": "[stern][threatening] Move, or meet my blade!", "direction": "像手已经握住剑柄，Move 直接喝出，后半句杀气更重，blade 结实落下。" },
    { "id": "KnightChaseRobber_L2_B", "level": 2, "action": "驱赶强盗", "variant": "B", "text": "Thieving scum! Face me!", "translation": "强盗杂碎！有种就来！", "promptText": "[disgusted][challenging] Thieving scum! Face me!", "direction": "先带鄙夷骂出 scum，再迎面挑衅 Face me，第二句更短更锋利。" },
    { "id": "KnightChaseRobber_L3_A", "level": 3, "action": "驱赶强盗", "variant": "A", "text": "Leave now, or die where you stand.", "translation": "马上滚，否则就死在这儿。", "promptText": "[coldly][threatening] Leave now, or die where you stand.", "direction": "压着怒意逼强盗离开，Leave now 是硬命令，后半句冷而清楚，像最后一次警告。" },
    { "id": "KnightChaseRobber_L3_B", "level": 3, "action": "驱赶强盗", "variant": "B", "text": "I'll put you in the dirt.", "translation": "我送你进坟墓。", "promptText": "[coldly][menacing] I'll put you in the dirt.", "direction": "对眼前敌人低声说狠话，语气笃定，put you 与 dirt 加重，保持自然人的威胁。" },
    { "id": "KnightAttack_L1_A", "level": 1, "action": "进攻", "variant": "A", "text": "I'll cut you down!", "translation": "我砍翻你！", "promptText": "[angry][shouts] I'll cut you down!", "direction": "年轻骑士冲上去前的短战吼，一口气发出，cut you down 有前冲的攻击性。" },
    { "id": "KnightAttack_L1_B", "level": 1, "action": "进攻", "variant": "B", "text": "You're going down!", "translation": "你完了！", "promptText": "[furious][challenging] You're going down!", "direction": "锁定敌人后猛地挑衅，年轻气盛，going down 更强，句尾干脆。" },
    { "id": "KnightAttack_L2_A", "level": 2, "action": "进攻", "variant": "A", "text": "Break their line!", "translation": "撕开他们的防线！", "promptText": "[commanding][shouts] Break their line!", "direction": "老兵在交锋前吼出短命令，Break 爆发，line 加重，带领人正面突破的狠劲。" },
    { "id": "KnightAttack_L2_B", "level": 2, "action": "进攻", "variant": "B", "text": "Cut them down!", "translation": "砍翻他们！", "promptText": "[fierce][shouts] Cut them down!", "direction": "发起攻击瞬间的果断战吼；三个词紧凑、清楚，气息有力量，迅速收尾。" },
    { "id": "KnightAttack_L3_A", "level": 3, "action": "进攻", "variant": "A", "text": "No quarter!", "translation": "不留活口！", "promptText": "[furious][commanding][shouts] No quarter!", "direction": "重骑士真正出手时放开的战吼，胸声厚、有决心，quarter 坚决砸下，短促有压迫。" },
    { "id": "KnightAttack_L3_B", "level": 3, "action": "进攻", "variant": "B", "text": "Crush them. Every last one.", "translation": "碾碎他们，一个不留。", "promptText": "[commanding] Crush them. [coldly][menacing] Every last one.", "direction": "先强硬下达碾压命令，稍停后把 Every last one 说得更冷更狠，突出 last one。" },
    { "id": "KnightMove_L1_A", "level": 1, "action": "移动", "variant": "A", "text": "On my way!", "translation": "这就过去！", "promptText": "[casual][upbeat] On my way!", "direction": "听见安排就随口答应，轻快、短、像已经迈步的应答。" },
    { "id": "KnightMove_L1_B", "level": 1, "action": "移动", "variant": "B", "text": "Aye. Over there, then.", "translation": "行，就去那边。", "promptText": "[casual][conversational] Aye. Over there, then.", "direction": "看了看玩家指的位置再应一声，带自然口语连读，then 轻轻落下。" },
    { "id": "KnightMove_L2_A", "level": 2, "action": "移动", "variant": "A", "text": "Moving out.", "translation": "动身。", "promptText": "[matter-of-fact][firm] Moving out.", "direction": "老兵收拾妥当后简短确认，声音松而有把握，一口说完。" },
    { "id": "KnightMove_L2_B", "level": 2, "action": "移动", "variant": "B", "text": "I'll take that post.", "translation": "那个位置，我来守。", "promptText": "[casual][confident] I'll take that post.", "direction": "把移防当成日常差事，顺口应下，that post 稍重，听起来可靠。" },
    { "id": "KnightMove_L3_A", "level": 3, "action": "移动", "variant": "A", "text": "Taking position.", "translation": "前往就位。", "promptText": "[calm][matter-of-fact] Taking position.", "direction": "重骑士简短确认移驻，沉稳、省力，像对熟悉同伴近距离回话。" },
    { "id": "KnightMove_L3_B", "level": 3, "action": "移动", "variant": "B", "text": "Leave that flank to me.", "translation": "那一翼交给我。", "promptText": "[assured][conversational] Leave that flank to me.", "direction": "自然接过侧翼职责，有分量且带温度，最后 to me 落稳。" }
  ]
